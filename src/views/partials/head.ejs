<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#050506">
  <title><%= title %> | <%= appName %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app-shell" id="appShell">
  <aside class="sidebar" id="sidebar" aria-label="Primary navigation">
    <div class="sidebar-top">
      <a class="brand" href="/" aria-label="TZ Number Toolkit home">
        <span class="brand-mark">TZ</span>
        <span class="brand-copy"><strong>TZ Number</strong><small>Toolkit</small></span>
      </a>
      <button class="icon-button sidebar-close" id="sidebarClose" type="button" aria-label="Close sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="nav">
      <a class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 13h6V4H4v9Zm10 7h6V11h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z"/></svg><span class="nav-label">Dashboard</span>
      </a>
      <a class="nav-link <%= page === 'generator' ? 'active' : '' %>" href="/generator">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg><span class="nav-label">Generator</span>
      </a>
      <a class="nav-link <%= page === 'analyzer' ? 'active' : '' %>" href="/analyzer">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 19V9m5 10V5m5 14v-7m5 7V3"/></svg><span class="nav-label">Bulk Analyzer</span>
      </a>

      <div class="nav-divider"></div>

      <button class="nav-action" type="button" data-open-modal="quickDetectorModal">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6M11 8v6"/></svg><span class="nav-label">Detector</span>
      </button>
      <button class="nav-action" type="button" data-open-modal="networkAllocationModal">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 20V10m0 0 4-4m-4 4L8 6M5 20h14M4 4h16"/></svg><span class="nav-label">Network Allocation</span>
      </button>
      <button class="nav-action" type="button" data-open-modal="historyModal" data-history-limit="100">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7L3 8m0-5v5h5M12 7v5l3 2"/></svg><span class="nav-label">History</span>
      </button>

      <div class="nav-divider"></div>

      <a class="nav-link <%= page === 'networks' ? 'active' : '' %>" href="/networks">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M5 17a10 10 0 0 1 14 0M8 14a6 6 0 0 1 8 0m-5 3a2 2 0 0 1 2 0M12 20h.01"/></svg><span class="nav-label">Allocation Page</span>
      </a>
      <a class="nav-link <%= page === 'developer' ? 'active' : '' %>" href="/developer">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="m8 9-3 3 3 3m8-6 3 3-3 3m-2-9-4 12"/></svg><span class="nav-label">Developer API</span>
      </a>
    </nav>

    <div class="sidebar-note"><strong>Registry mode</strong>Prefix allocation indicates original numbering assignment. MNP can change the current carrier.</div>
  </aside>

  <main class="main">
    <header class="topbar">
      <button class="icon-button" id="sidebarToggle" type="button" aria-label="Open or collapse sidebar" aria-expanded="true">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="topbar-title">
        <div class="eyebrow">Tanzania number intelligence</div>
        <h1><%= title %></h1>
      </div>
      <div class="topbar-actions">
        <button class="button ghost" type="button" data-open-modal="quickDetectorModal">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span class="topbar-action-label">Detect</span>
        </button>
      </div>
    </header>
    <section class="content">
